# ── Stripe ─────────────────────────────────────────────
# Secret key (test: sk_test_..., live: sk_live_...)
NUXT_STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret from `stripe listen` (whsec_...) or the Stripe Dashboard
NUXT_STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Resend (email delivery) ────────────────────────────
NUXT_RESEND_API_KEY=re_xxx
# Must be a verified sender/domain in Resend
NUXT_EMAIL_FROM=Workbook <kontakt@twojadomena.pl>

# ── Public site URL ────────────────────────────────────
# Used for Stripe redirect + email download links. No trailing slash.
# Local: http://localhost:3000  ·  Prod: https://twojadomena.pl
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Meta (Facebook) Pixel ──────────────────────────────
# Pixel ID from Meta Events Manager (a ~15-digit number).
# Leave empty to disable the pixel (recommended for local dev).
NUXT_PUBLIC_META_PIXEL_ID=
